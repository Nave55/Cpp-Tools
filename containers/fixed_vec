#pragma once

#include <algorithm>
#include <cstdio>
#include <optional>
#include <span>
#include <typeinfo>

template <typename T, size_t N>
struct FixedVec {
  T arr[N] = {};
  size_t len = 0;
  size_t cap = N;

  explicit FixedVec() = default;

  explicit FixedVec(std::initializer_list<T> lst) {
    size_t count = (N < lst.size()) ? N : lst.size();
    auto it = lst.begin();
    for (size_t i = 0; i < count; ++i) {
      arr[i] = *it++;
    }
    len = count;
  }

  FixedVec(const FixedVec& other)
      : len(other.len),
        cap(other.cap) {
    for (size_t i = 0; i < other.len; ++i) {
      arr[i] = other.arr[i];
    }
  }

  FixedVec(FixedVec&& other) noexcept
      : len(other.len),
        cap(other.cap) {
    for (size_t i = 0; i < other.len; ++i) {
      arr[i] = std::move(other.arr[i]);
    }
    other.len = 0;
  }

  FixedVec& operator=(const FixedVec& other) {
    if (this != &other) {
      for (size_t i = 0; i < other.len; ++i) {
        arr[i] = other.arr[i];
      }
      len = other.len;
      cap = other.cap;
    }
    return *this;
  }

  FixedVec& operator=(FixedVec&& other) noexcept {
    if (this != &other) {
      for (size_t i = 0; i < other.len; ++i) {
        arr[i] = std::move(other.arr[i]);
      }
      len = other.len;
      cap = other.cap;
      other.len = 0;
    }
    return *this;
  }

  ~FixedVec() = default;

  T& operator[](size_t i) noexcept {
    return arr[i];
  }

  const T& operator[](size_t i) const noexcept {
    return arr[i];
  }

  std::optional<T&> at(size_t i) noexcept {
    if (i >= len) return std::nullopt;
    return arr[i];
  }

  std::optional<const T&> at(size_t i) const noexcept {
    if (i >= len) return std::nullopt;
    return arr[i];
  }

  T* begin() noexcept {
    return &arr[0];
  }

  const T* begin() const noexcept {
    return &arr[0];
  }

  std::span<T> slice(size_t start, size_t end) noexcept {
    if (start >= end) return {};
    size_t actual_end = std::min(len, end);
    return std::span<T>(begin() + start, begin() + actual_end);
  }

  std::span<T> toSpan() noexcept {
    return std::span<T>(&arr[0], len);
  }

  const char* type() const noexcept {
    return typeid(T).name();
  }

  template <typename PrintFn>
  void print(PrintFn printFn) const noexcept {
    std::printf("[");
    for (size_t i = 0; i < len; ++i) {
      if (i > 0) std::printf(", ");
      printFn(arr[i]);
    }
    std::printf("]\n");
  }

  void printInfo() const noexcept {
    std::printf("length: ");
    std::printf("%zu", len);
    std::printf(", capacity: ");
    std::printf("%zu", cap);
    std::printf(", type: ");
    printf("%s", type());
    std::printf("\n");
  }

  T* end() noexcept {
    return &arr[len];
  }

  const T* end() const noexcept {
    return &arr[len];
  }

  T first() const noexcept {
    return arr[0];
  }

  T last() const noexcept {
    return arr[len - 1];
  }

  void clear() noexcept {
    len = 0;
  }

  void fill(const T& val) noexcept {
    std::fill(begin(), end(), val);
  }

  void reverse() noexcept {
    for (size_t i = 0; i < len / 2; ++i) std::swap(arr[i], arr[len - 1 - i]);
  }

  void sort() noexcept {
    std::sort(begin(), end());
  }

  void sortDescending() noexcept {
    std::sort(begin(), end(), [](const T& a, const T& b) { return a > b; });
  }

  template <typename Fn>
  void sortCustom(Fn fn) noexcept {
    std::sort(begin(), end(), fn);
  }

  std::optional<int> linearSearch(T x) const noexcept {
    for (size_t i = 0; i < len; i++) {
      if (arr[i] == x) return i;
    }

    return std::nullopt;
  }

  std::optional<int> binarySearch(T x) const noexcept {
    int high = len - 1;
    int low = 0;

    while (low <= high) {
      int mid = low + ((high - low) / 2);
      if (arr[mid] == x)
        return mid;
      else if (arr[mid] > x)
        high = mid - 1;
      else
        low = mid + 1;
    }

    return std::nullopt;
  }

  void extend(size_t new_size, T val = T()) noexcept {
    size_t min_size = std::min(N, new_size);
    for (size_t i = len; i < min_size; ++i) arr[i] = val;
    len = min_size;
  }

  void reserve(size_t new_size) noexcept {
    len = std::min(N, new_size);
  }

  template <typename S>
    requires std::is_same_v<std::remove_cvref_t<S>, T>
  void pushBack(S&& val) noexcept {
    arr[len++] = std::forward<S>(val);
  }

  template <typename... Args>
    requires(sizeof...(Args) == 1 &&
             std::is_same_v<T, std::remove_cvref_t<Args>...>)
  void emplaceBack(Args&&... args) noexcept {
    new (&arr[len]) T(std::forward<Args>(args)...);
    ++len;
  }

  template <typename S>
    requires std::is_same_v<std::remove_cvref_t<S>, T>
  void insert(S&& val, size_t ind) noexcept {
    if (ind > len) ind = len;
    for (size_t i = len; i > ind; --i) arr[i] = std::move(arr[i - 1]);

    arr[ind] = std::forward<S>(val);
    ++len;
  }

  void pop() noexcept {
    if (len != 0) {
      len--;
    }
  }

  std::optional<T> popBack() noexcept {
    if (len == 0) return std::nullopt;
    return std::move(arr[--len]);
  }

  T popBackUnsafe() noexcept {
    return std::move(arr[--len]);
  }
  void orderedRemove(size_t ind) noexcept {
    if (ind >= len) return;
    for (size_t i = ind; i + 1 < len; ++i) arr[i] = std::move(arr[i + 1]);
    --len;
  }

  void unorderedRemove(size_t ind) noexcept {
    if (ind >= len) return;
    arr[ind] = std::move(arr[len - 1]);
    --len;
  }

  void deleteVal(T val) noexcept {
    for (int i = len - 1; i >= 0; --i)
      if (arr[i] == val) orderedRemove(i);
  }

  void deleteValUnordered(T val) noexcept {
    for (int i = len - 1; i >= 0; --i)
      if (arr[i] == val) unorderedRemove(i);
  }

  template <typename Fn>
  void mapIter(Fn fn) noexcept {
    for (size_t i = 0; i < len; ++i) fn(arr[i]);
  }

  template <typename Rtype>
    requires std::is_arithmetic_v<Rtype> && std::is_arithmetic_v<T>
  std::optional<Rtype> sum() const noexcept {
    if (len == 0) return std::nullopt;
    if (len == 1) return static_cast<Rtype>(arr[0]);
    Rtype ttl = 0;
    for (size_t i = 0; i < len; ++i) ttl += static_cast<Rtype>(arr[i]);
    return ttl;
  }

  template <typename Rtype>
    requires std::is_arithmetic_v<Rtype> && std::is_arithmetic_v<T>
  std::optional<Rtype> prod() const noexcept {
    if (len == 0) return std::nullopt;
    if (len == 1) return static_cast<Rtype>(arr[0]);
    Rtype ttl = 1;
    for (size_t i = 0; i < len; ++i) ttl *= static_cast<Rtype>(arr[i]);
    return ttl;
  }

  template <typename Rtype, typename Fn>
  std::optional<Rtype> foldl(size_t init, Fn fn) const noexcept {
    if (len == 0) return std::nullopt;
    Rtype ttl = init;
    for (size_t i = 0; i < len; ++i) fn(ttl, static_cast<Rtype>(arr[i]));
    return ttl;
  }

  template <typename Rtype, typename Fn>
  std::optional<Rtype> reduce(Fn fn) const noexcept {
    if (len <= 0) return std::nullopt;
    if (len == 1) return static_cast<Rtype>(arr[0]);
    Rtype ttl = static_cast<Rtype>(arr[0]);
    for (size_t i = 1; i < len; ++i) fn(ttl, static_cast<Rtype>(arr[i]));
    return ttl;
  }
};
